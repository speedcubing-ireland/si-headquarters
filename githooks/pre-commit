#!/usr/bin/env bash
# Use `git commit --no-verify` to bypass all checks in this hook.

# ── Secret guard ────────────────────────────────────────────────────────────
SETUP_SCRIPT="scripts/set-convex-env.sh"

if git diff --cached --name-only | grep -qF "$SETUP_SCRIPT"; then
    staged=$(git show ":${SETUP_SCRIPT}" 2>/dev/null || true)

    # Find active (non-commented) convex env set lines whose value is NOT a <placeholder>.
    leaked=$(printf '%s\n' "$staged" \
        | grep -E '^[[:space:]]*(bunx |npx )?convex env set\b.*[A-Z_]{2,}' \
        | grep -vE '"<[^"]+>"' \
        | grep -vE '#\s*safe-value\s*$')

    if [ -n "$leaked" ]; then
        printf '\n\033[1;31mERROR\033[0m: %s contains real secret values.\n' "$SETUP_SCRIPT"
        printf 'Replace all filled-in values with their original <PLACEHOLDER> before committing.\n\n'
        printf 'Affected lines:\n'
        printf '%s\n' "$leaked" | sed 's/^/  /'
        printf '\n'
        exit 1
    fi
fi

# ── Pre-commit checks ────────────────────────────────────────────────────────

# Skip when nothing is staged (e.g. --allow-empty commits)
if [ -z "$(git diff --cached --name-only)" ]; then
    exit 0
fi

# Capture staged files (for lint fix guard) before anything runs
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# ── TUI helpers ─────────────────────────────────────────────────────────────
BOLD='\033[1m'
DIM='\033[2m'
RED='\033[0;31m'
GREEN='\033[0;32m'
RESET='\033[0m'

IS_TTY=false
[ -t 1 ] && IS_TTY=true

SPINNER_FRAMES=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
SPINNER_PID=""

_start_spinner() {
    local label="$1"
    if $IS_TTY; then
        (
            local i=0
            while true; do
                printf "\r  ${SPINNER_FRAMES[$i]} %s  " "$label"
                i=$(( (i + 1) % ${#SPINNER_FRAMES[@]} ))
                sleep 0.1
            done
        ) &
        SPINNER_PID=$!
    else
        printf "  ▶ %s\n" "$label"
    fi
}

_stop_spinner() {
    if $IS_TTY && [ -n "$SPINNER_PID" ]; then
        kill "$SPINNER_PID" 2>/dev/null
        wait "$SPINNER_PID" 2>/dev/null
        SPINNER_PID=""
        # Clear the spinner line
        printf "\r\033[K"
    fi
}

_step_pass() {
    local label="$1" elapsed="$2"
    _stop_spinner
    printf "  ${GREEN}✓${RESET} %s  ${DIM}${elapsed}s${RESET}\n" "$label"
}

_step_fail() {
    local label="$1" elapsed="$2" outfile="$3"
    _stop_spinner
    printf "  ${RED}✗${RESET} ${BOLD}%s${RESET}  ${DIM}${elapsed}s${RESET}\n" "$label"
    printf "\n${DIM}──────────────────────────────────────────${RESET}\n"
    cat "$outfile"
    printf "${DIM}──────────────────────────────────────────${RESET}\n\n"
}

# Cleanup on interrupt/terminate
_cleanup() {
    _stop_spinner
    rm -f /tmp/precommit_step_*.$$
    exit 1
}
trap _cleanup INT TERM

# ── Run a single step ────────────────────────────────────────────────────────
# Usage: run_step "Label" cmd [args...]
# Returns 1 on failure (and prints output), 0 on success.
run_step() {
    local label="$1"; shift
    local outfile
    outfile=$(mktemp /tmp/precommit_step_.$$.XXXXXX)
    local start elapsed

    _start_spinner "$label"
    start=$SECONDS
    "$@" >"$outfile" 2>&1
    local status=$?
    elapsed=$(( SECONDS - start ))

    if [ $status -eq 0 ]; then
        _step_pass "$label" "$elapsed"
        rm -f "$outfile"
        return 0
    else
        _step_fail "$label" "$elapsed" "$outfile"
        rm -f "$outfile"
        return 1
    fi
}

# ── Steps ────────────────────────────────────────────────────────────────────

TOTAL_START=$SECONDS

printf "\n${BOLD}Running pre-commit checks…${RESET}  ${DIM}(--no-verify to skip)${RESET}\n\n"

# 1. Lint (biome --fix)
run_step "lint" bun run lint || exit 1

# Guard: if lint fixed any staged file, abort so the user can re-stage.
FIXED_FILES=""
while IFS= read -r f; do
    if [ -n "$f" ] && git diff --name-only | grep -qxF "$f"; then
        FIXED_FILES="${FIXED_FILES}  ${f}\n"
    fi
done <<< "$STAGED_FILES"

if [ -n "$FIXED_FILES" ]; then
    printf "  ${RED}✗${RESET} ${BOLD}lint${RESET} applied fixes to staged files — re-stage and commit again:\n"
    printf "$FIXED_FILES"
    printf "\n"
    exit 1
fi

# 2. Lint Convex
run_step "lint:convex" bun run lint:convex || exit 1

# 3. Typecheck
run_step "typecheck" bun run typecheck || exit 1

# 4. Tests
run_step "tests" bun run test:once || exit 1

TOTAL=$(( SECONDS - TOTAL_START ))
printf "\n  ${GREEN}${BOLD}All checks passed${RESET}  ${DIM}${TOTAL}s${RESET}\n\n"
