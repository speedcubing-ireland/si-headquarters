#!/usr/bin/env bash
# Use `git commit --no-verify` to bypass all checks in this hook.

# ── Pre-commit checks ────────────────────────────────────────────────────────

# Skip when nothing is staged (e.g. --allow-empty commits)
if [ -z "$(git diff --cached --name-only)" ]; then
    exit 0
fi

# ── TUI helpers ─────────────────────────────────────────────────────────────
BOLD='\033[1m'
DIM='\033[2m'
RED='\033[0;31m'
GREEN='\033[0;32m'
RESET='\033[0m'

IS_TTY=false
[ -t 1 ] && IS_TTY=true

SPINNER_FRAMES=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
SPINNER_PID=""

_start_spinner() {
    local label="$1"
    if $IS_TTY; then
        (
            local i=0
            while true; do
                printf "\r  ${SPINNER_FRAMES[$i]} %s  " "$label"
                i=$(( (i + 1) % ${#SPINNER_FRAMES[@]} ))
                sleep 0.1
            done
        ) &
        SPINNER_PID=$!
    else
        printf "  ▶ %s\n" "$label"
    fi
}

_stop_spinner() {
    if $IS_TTY && [ -n "$SPINNER_PID" ]; then
        kill "$SPINNER_PID" 2>/dev/null
        wait "$SPINNER_PID" 2>/dev/null
        SPINNER_PID=""
        # Clear the spinner line
        printf "\r\033[K"
    fi
}

_step_pass() {
    local label="$1" elapsed="$2"
    _stop_spinner
    printf "  ${GREEN}✓${RESET} %s  ${DIM}${elapsed}s${RESET}\n" "$label"
}

_step_fail() {
    local label="$1" elapsed="$2" outfile="$3"
    _stop_spinner
    printf "  ${RED}✗${RESET} ${BOLD}%s${RESET}  ${DIM}${elapsed}s${RESET}\n" "$label"
    printf "\n${DIM}──────────────────────────────────────────${RESET}\n"
    cat "$outfile"
    printf "${DIM}──────────────────────────────────────────${RESET}\n\n"
}

# Cleanup on interrupt/terminate
_cleanup() {
    _stop_spinner
    rm -f /tmp/precommit_step_*.$$
    exit 1
}
trap _cleanup INT TERM

# ── Run a single step ────────────────────────────────────────────────────────
# Usage: run_step "Label" cmd [args...]
# Returns 1 on failure (and prints output), 0 on success.
run_step() {
    local label="$1"; shift
    local outfile
    outfile=$(mktemp /tmp/precommit_step_.$$.XXXXXX)
    local start elapsed

    _start_spinner "$label"
    start=$SECONDS
    "$@" >"$outfile" 2>&1
    local status=$?
    elapsed=$(( SECONDS - start ))

    if [ $status -eq 0 ]; then
        _step_pass "$label" "$elapsed"
        rm -f "$outfile"
        return 0
    else
        _step_fail "$label" "$elapsed" "$outfile"
        rm -f "$outfile"
        return 1
    fi
}

# ── Steps ────────────────────────────────────────────────────────────────────

TOTAL_START=$SECONDS

printf "\n${BOLD}Running pre-commit checks…${RESET}  ${DIM}(--no-verify to skip)${RESET}\n\n"

# 1. Lint (eslint — covers src, convex, and scripts)
run_step "lint" bun run lint || exit 1

# 2. Typecheck (app, node, convex, scripts)
run_step "typecheck" bun run typecheck || exit 1

# 3. Tests (convex and src)
run_step "tests" bun run test:once || exit 1

TOTAL=$(( SECONDS - TOTAL_START ))
printf "\n  ${GREEN}${BOLD}All checks passed${RESET}  ${DIM}${TOTAL}s${RESET}\n\n"
