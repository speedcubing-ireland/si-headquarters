{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"buildCommand": "bun run build:deploy",
	"redirects": [
		{
			"source": "/",
			"has": [{ "type": "host", "value": "sponsors.speedcubingireland.com" }],
			"destination": "/sponsor/login",
			"permanent": false
		},
		{
			"source": "/sponsor",
			"has": [{ "type": "host", "value": "hq.speedcubingireland.com" }],
			"destination": "https://sponsors.speedcubingireland.com/sponsor",
			"permanent": false
		},
		{
			"source": "/sponsor/(.*)",
			"has": [{ "type": "host", "value": "hq.speedcubingireland.com" }],
			"destination": "https://sponsors.speedcubingireland.com/sponsor/$1",
			"permanent": false
		}
	],
	"rewrites": [
		{
			"source": "/(.*)",
			"destination": "/index.html"
		}
	],
	"git": {
		"deploymentEnabled": false
	}
}
