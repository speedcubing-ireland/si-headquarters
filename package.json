{
  "name": "si-headquarters",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath githooks && chmod +x githooks/pre-commit || true",
    "dev": "bun run --parallel dev:frontend dev:sponsor dev:backend",
    "dev:frontend": "vite --port 5173",
    "dev:sponsor": "VITE_SPONSOR_SITE=1 vite --port 5174 --open /login",
    "dev:backend": "convex dev",
    "dev:vite": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware --fix .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "build:deploy": "bunx convex deploy --cmd 'bun run build'",
    "test": "vitest",
    "test:once": "vitest run",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:coverage": "vitest run --coverage --coverage.reporter=text",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsgo -p convex/tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit",
    "auth": "bun scripts/auth.ts",
    "set-convex-env": "bun scripts/set-convex-env.ts",
    "preview": "vite preview",
    "openapi-ts": "openapi-ts",
    "email:dev": "email dev --dir convex/plugins/sponsor/emails --port 3000"
  },
  "dependencies": {
    "@auth/core": "0.41.2",
    "@autoform/react": "^4.0.0",
    "@autoform/zod": "^5.0.0",
    "@base-ui/react": "^1.5.0",
    "@chenglou/pretext": "^0.0.8",
    "@convex-dev/auth": "^0.0.94",
    "@convex-dev/better-auth": "^0.12.3",
    "@convex-dev/resend": "^0.2.4",
    "@convex/reactions": "github:get-convex/reactions",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/noto-sans": "^5.2.10",
    "@noble/ed25519": "^3.1.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-slot": "^1.2.5",
    "@react-email/components": "^1.0.12",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-router": "^1.170.15",
    "@tiptap/extension-bubble-menu": "^3.26.1",
    "@tiptap/extension-code-block-lowlight": "^3.26.1",
    "@tiptap/extension-color": "^3.26.1",
    "@tiptap/extension-horizontal-rule": "^3.26.1",
