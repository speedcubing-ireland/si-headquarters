{
  "name": "si-headquarters",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel dev:frontend dev:sponsor dev:backend",
    "dev:frontend": "vite --port 5173",
    "dev:sponsor": "VITE_SPONSOR_SITE=1 vite --port 5174 --open /login",
    "dev:backend": "convex dev",
    "dev:vite": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "test": "vitest",
    "test:once": "vitest run",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:coverage": "vitest run --coverage --coverage.reporter=text",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p convex/tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit",
    "auth": "bun scripts/auth.ts",
    "preview": "vite preview",
    "openapi-ts": "openapi-ts",
    "email:dev": "email dev --dir convex/plugins/sponsor/emails --port 3000"
  },
  "dependencies": {
    "@auth/core": "0.37.0",
    "@base-ui/react": "^1.5.0",
    "@chenglou/pretext": "^0.0.7",
    "@convex-dev/auth": "^0.0.92",
    "@convex-dev/better-auth": "^0.12.2",
    "@convex-dev/resend": "^0.2.4",
    "@convex/reactions": "github:get-convex/reactions",
    "@fontsource-variable/noto-sans": "^5.2.10",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-email/components": "^1.0.12",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-router": "^1.170.7",
    "@tiptap/extension-bubble-menu": "^3.23.6",
    "@tiptap/extension-code-block-lowlight": "^3.23.6",
    "@tiptap/extension-color": "^3.23.6",
    "@tiptap/extension-horizontal-rule": "^3.23.6",
    "@tiptap/extension-image": "^3.23.6",
    "@tiptap/extension-list": "^3.23.6",
    "@tiptap/extension-table": "^3.23.6",
    "@tiptap/extension-text-style": "^3.23.6",
    "@tiptap/extension-typography": "^3.23.6",
    "@tiptap/extensions": "^3.23.6",
    "@tiptap/markdown": "^3.23.6",
    "@tiptap/pm": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "better-auth": "^1.6.11",
