{
	"name": "headquarters",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "npm-run-all --parallel dev:frontend dev:backend",
		"dev:frontend": "vite --open",
		"dev:backend": "convex dev",
		"build": "tsgo -b && vite build",
		"typecheck": "tsgo -b && cd convex && tsgo -b",
		"lint": "biome lint --fix --unsafe && biome format --write",
		"preview": "vite preview",
		"auth": "bun run scripts/auth.ts",
		"auth:prod": "CONVEX_PROD=1 bun run scripts/auth.ts",
		"test": "vitest",
		"test:once": "vitest run",
		"test:debug": "vitest --inspect-brk --no-file-parallelism",
		"test:coverage": "vitest run --coverage",
		"openapi-ts": "openapi-ts"
	},
	"dependencies": {
		"@auth/core": "^0.37.4",
		"@azure/communication-email": "^1.1.0",
		"@better-auth/passkey": "1.4.9",
		"@convex-dev/auth": "^0.0.90",
		"@convex-dev/better-auth": "^0.10.10",
		"@convex-dev/crons": "^0.2.0",
		"@dicebear/collection": "^9.3.1",
		"@dicebear/core": "^9.3.1",
		"@diceui/mention": "^0.8.0",
		"@radix-ui/react-alert-dialog": "^1.1.15",
		"@radix-ui/react-avatar": "^1.1.11",
		"@radix-ui/react-checkbox": "^1.3.3",
		"@radix-ui/react-collapsible": "^1.1.12",
		"@radix-ui/react-context-menu": "^2.2.16",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@radix-ui/react-label": "^2.1.8",
		"@radix-ui/react-popover": "^1.1.15",
		"@radix-ui/react-scroll-area": "^1.2.10",
		"@radix-ui/react-select": "^2.2.6",
		"@radix-ui/react-separator": "^1.1.8",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-tabs": "^1.1.13",
		"@radix-ui/react-tooltip": "^1.2.8",
		"@react-email/components": "^1.0.7",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-router": "^1.157.16",
		"@tanstack/react-table": "^8.21.3",
		"better-auth": "1.4.9",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"convex": "^1.31.7",
		"date-fns": "^4.1.0",
		"date-fns-tz": "^3.2.0",
		"fuse.js": "^7.1.0",
		"googleapis": "^144.0.0",
		"lucide-react": "^0.563.0",
		"next-themes": "^0.4.6",
		"otplib": "^13.3.0",
		"react": "^19.2.0",
		"react-day-picker": "^9.13.2",
		"react-dom": "^19.2.0",
		"react-markdown": "^9.0.1",
		"rehype-sanitize": "^6.0.0",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.4.0",
		"tailwindcss": "^4.1.18",
		"uuid": "^13.0.0",
		"vite": "^7.3.1",
