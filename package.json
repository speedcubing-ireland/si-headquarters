    "@hey-api/openapi-ts": "^0.97.2",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/router-plugin": "^1.168.10",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.12.4",
