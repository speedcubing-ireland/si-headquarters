    "lucide-react": "^1.18.0",
    "next-themes": "^0.4.6",
    "otplib": "^13.4.1",
    "radix-ui": "^1.5.0",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.79.0",
    "react-medium-image-zoom": "^5.4.7",
    "react-resizable-panels": "^4.11.2",
    "recharts": "^3.8.1",
