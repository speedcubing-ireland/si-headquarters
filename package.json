{
	"name": "headquarters",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"prepare": "git config core.hooksPath githooks && chmod +x githooks/pre-commit || true",
		"dev": "npm-run-all --parallel dev:frontend dev:backend",
		"dev:frontend": "vite --open",
		"dev:backend": "convex dev",
		"build": "tsgo -b && vite build",
		"typecheck": "tsgo -b && cd convex && tsgo -b",
		"lint": "biome lint --fix --unsafe && biome format --write",
		"lint:convex": "eslint convex",
		"preview": "vite preview",
		"auth": "bun run scripts/auth.ts",
		"auth:prod": "CONVEX_PROD=1 bun run scripts/auth.ts",
		"test": "vitest --isolate",
		"test:once": "vitest run --isolate",
		"test:debug": "vitest --inspect-brk --no-file-parallelism --isolate",
		"test:coverage": "vitest run --coverage --isolate",
		"openapi-ts": "openapi-ts",
		"build:deploy": "bun convex deploy --cmd 'bun run build'"
	},
	"dependencies": {
		"@auth/core": "^0.37.4",
		"@azure/communication-email": "^1.1.0",
		"@better-auth/passkey": "1.4.18",
		"@convex-dev/auth": "^0.0.90",
		"@convex-dev/better-auth": "^0.11.3",
		"@convex-dev/crons": "^0.2.0",
		"@dicebear/collection": "^9.4.2",
		"@dicebear/core": "^9.4.2",
		"@diceui/mention": "^0.8.0",
		"@radix-ui/react-alert-dialog": "^1.1.15",
		"@radix-ui/react-avatar": "^1.1.11",
		"@radix-ui/react-checkbox": "^1.3.3",
		"@radix-ui/react-collapsible": "^1.1.12",
		"@radix-ui/react-context-menu": "^2.2.16",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@radix-ui/react-label": "^2.1.8",
		"@radix-ui/react-popover": "^1.1.15",
		"@radix-ui/react-scroll-area": "^1.2.10",
		"@radix-ui/react-select": "^2.2.6",
		"@radix-ui/react-separator": "^1.1.8",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-tabs": "^1.1.13",
		"@radix-ui/react-tooltip": "^1.2.8",
		"@react-email/components": "^1.0.10",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"@tanstack/react-router": "^1.168.3",
		"@tanstack/react-table": "^8.21.3",
		"better-auth": "1.4.18",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"convex": "^1.34.0",
		"date-fns": "^4.1.0",
		"date-fns-tz": "^3.2.0",
		"fuse.js": "^7.1.0",
		"googleapis": "^171.4.0",
		"lucide-react": "^0.575.0",
		"next-themes": "^0.4.6",
		"otplib": "^13.4.0",
		"react": "^19.2.4",
		"react-day-picker": "^9.14.0",
		"react-dom": "^19.2.4",
		"react-markdown": "^10.1.0",
		"rehype-sanitize": "^6.0.0",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.5.0",
		"tailwindcss": "^4.2.2",
		"uuid": "^13.0.0",
		"vite": "^7.3.1",
		"zod": "^4.3.6",
		"zustand": "^5.0.12"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.4",
		"@convex-dev/eslint-plugin": "^1.2.1",
		"@edge-runtime/vm": "^5.0.0",
		"@hey-api/openapi-ts": "0.92.4",
		"@tanstack/router-plugin": "^1.167.4",
		"@types/bun": "^1.3.11",
		"@types/node": "^25.5.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@typescript-eslint/parser": "^8.57.2",
		"@typescript/native-preview": "^7.0.0-dev.20260323.1",
		"@vitejs/plugin-react": "^5.2.0",
		"@vitest/coverage-v8": "^4.1.1",
		"convex-test": "^0.0.41",
		"eslint": "^9.39.4",
		"npm-run-all2": "^8.0.4",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"unplugin-fonts": "^1.4.0",
		"vitest": "^4.1.1"
	},
	"overrides": {
		"vite": "npm:rolldown-vite@latest"
	}
}
